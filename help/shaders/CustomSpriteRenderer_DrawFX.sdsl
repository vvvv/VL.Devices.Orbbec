[Summary("")]
shader CustomSpriteRenderer_DrawFX : VS_PS_Base, ColorBase, ShaderUtils, OrbbecPointcloud
{
    [Color]
    stage float4 ColorInput = float4(1, 1, 1, 1);

    stage float size = 0.001f;
    
    StructuredBuffer<PointcloudColor> Points;

    override stage void VSMain()
    {
        float3 p = Points[streams.InstanceID].Pos;
        float3 c = Points[streams.InstanceID].Col;

        float3 op = streams.Position * size;
        op = mul(float4(op, 1.0f), extract_rotation_matrix(ViewInverse)).xyz;
        op += p;        
        
        streams.ShadingPosition = mul(float4(op, 1.0f), WorldViewProjection);
        streams.Color = float4(c, 1.0f);
    }

    override stage void PSMain() 
    {
        streams.ColorTarget = streams.Color * ColorInput;
    }

    float4x4 extract_rotation_matrix(float4x4 m)
    {
        float sx = length(float3(m[0][0], m[0][1], m[0][2]));
        float sy = length(float3(m[1][0], m[1][1], m[1][2]));
        float sz = length(float3(m[2][0], m[2][1], m[2][2]));

        // if determine is negative, we need to invert one scale
        float det = determinant(m);
        if (det < 0) {
            sx = -sx;
        }

        float invSX = 1.0 / sx;
        float invSY = 1.0 / sy;
        float invSZ = 1.0 / sz;

        m[0][0] *= invSX;
        m[0][1] *= invSX;
        m[0][2] *= invSX;
        m[0][3] = 0;

        m[1][0] *= invSY;
        m[1][1] *= invSY;
        m[1][2] *= invSY;
        m[1][3] = 0;

        m[2][0] *= invSZ;
        m[2][1] *= invSZ;
        m[2][2] *= invSZ;
        m[2][3] = 0;

        m[3][0] = 0;
        m[3][1] = 0;
        m[3][2] = 0;
        m[3][3] = 1;

        return m;
    }
};