shader OrbbecPointcloud : ColorUtilityTemp
{
    struct PointcloudColor
    {
        float3 Pos;
        float3 Col;
    };

//////////
//helper methods
//////////

    PointcloudColor ToStrideSpace(PointcloudColor p)
    {
        p.Pos = p.Pos * float3(1.0f, -1.0f, -1.0f);
        float3 c = p.Col / 255.0f;
        p.Col = SRgbToLinearPrecise(float4(c, 1.0f)).xyz;
        return p;
    }
};