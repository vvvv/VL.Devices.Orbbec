[Summary("")]
shader ComputePointsColorToMatrices_ComputeFX : ComputeShaderBase, OrbbecPointcloud, TransformUtils
{
	struct Transform //needed put float4x4 into a structured buffer
    {
        float4x4 Matrix;
    };
    
    stage int count;
    stage float size = 0.001f;
    stage bool scaleZeroPositions = false;
    
    StructuredBuffer<PointcloudColor> Points;
	RWStructuredBuffer<Transform> InstanceWorld;
	RWStructuredBuffer<Transform> InstanceWorldInverse;

    override void Compute()
    {
        uint index = streams.DispatchThreadId.x;
        
        if (index >= count) return;

        float s = size;

        if (scaleZeroPositions)
        {
            bool condition = Points[index].Pos == float3(0.0f, 0.0f, 0.0f);
            if (condition)
            {
                s = 0.0f;
            }
        }

        float4x4 world;
        float4x4 worldInverse;

        TransformTSWithInverse(Points[index].Pos, s, world, worldInverse);

        InstanceWorld[index].Matrix = world;
        InstanceWorldInverse[index].Matrix = worldInverse;
    }
};